{
  "manifest_version": 3,
  "name": "Bookmark Navigation",
  "version": "1.1.6",
  "description": "Turn your new tab into a bookmark dashboard. Organize with drag and drop, search instantly, or connect your own AI provider.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
