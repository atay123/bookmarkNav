{
  "manifest_version": 3,
  "name": "Bookmark Navigation",
  "version": "1.1.5",
  "description": "Display browser bookmarks as a navigation dashboard, replacing the default new tab page.",
  "permissions": [
    "bookmarks",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
